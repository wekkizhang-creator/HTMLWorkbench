[Unit]
Description=HTMLWorkbench admin service
After=network.target

[Service]
Type=simple
User=htmlworkbench-admin
Group=htmlworkbench-admin
SupplementaryGroups=htmlworkbench-data
WorkingDirectory=/opt/html-workbench/current
Environment=NODE_ENV=production
Environment=HTML_WORKBENCH_ROLE=admin
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/etc/html-workbench.env
ExecStartPre=/usr/bin/node /opt/html-workbench/current/deploy/self-host/validate-env.mjs
ExecStart=/usr/bin/env NODE_ENV=production HTML_WORKBENCH_ROLE=admin HOST=127.0.0.1 PORT=3000 /usr/bin/node /opt/html-workbench/current/server.js
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/html-workbench

[Install]
WantedBy=multi-user.target
