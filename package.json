{
  "name": "html-publish-desk",
  "version": "1.0.0",
  "description": "A lightweight HTML upload and link management website.",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test",
    "migrate:record-index": "node scripts/migrate-record-index.mjs",
    "migrate:record-index:dry-run": "node scripts/migrate-record-index.mjs --dry-run",
    "migrate:record-index:recover": "node scripts/migrate-record-index.mjs --recover-lock",
    "check": "node scripts/check.mjs && node --test"
  },
  "keywords": [
    "html",
    "upload",
    "publisher"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "@vercel/functions": "^3.7.6"
  },
  "engines": {
    "node": ">=20"
  }
}
